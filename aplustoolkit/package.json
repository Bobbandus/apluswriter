{
  "name": "apluswrite",
  "version": "0.2.1",
  "private": true,
  "description": "A+ Write — a professional Fountain screenwriting app for A+ Studios.",
  "scripts": {
    "dev": "next dev aplusweb",
    "build": "next build aplusweb",
    "start": "next start aplusweb",
    "lint": "next lint aplusweb",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test",
    "mcp:build": "node mcp/build.mjs",
    "mcp": "node mcp/dist/server.mjs",
    "desktop": "npm --prefix aplusdesktop start",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:icon": "node scripts/make-icon.mjs",
    "mcpb": "node scripts/build-mcpb.mjs",
    "desktop:pack": "npm --prefix aplusdesktop run pack",
    "desktop:dist": "npm --prefix aplusdesktop run dist"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "next": "^15.1.4",
    "next-intl": "^3.26.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
