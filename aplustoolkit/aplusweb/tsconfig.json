{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Paths resolve against this file's directory, so they are restated here
    // rather than inherited — `../tsconfig.json` states them relative to the
    // repository root.
    "paths": {
      "@/*": [
        "./*"
      ],
      "@aplus/fountain/*": [
        "../packages/fountain/*"
      ],
      "@aplus/paginator/*": [
        "../packages/paginator/*"
      ],
      "@aplus/export/*": [
        "../packages/export/*"
      ],
      "@aplus/bridge/*": [
        "../packages/bridge/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../packages/**/*.ts",
    ".next-desktop/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-verify/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
