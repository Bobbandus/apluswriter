# Copy to aplusweb/.env.local — Next.js reads env files from THIS folder
# (`next dev aplusweb`), not from the repo root.
# Leave both empty to run fully local: cloud sync simply does not appear.
# Setup guide: supabase/README.md

NEXT_PUBLIC_SUPABASE_URL=
# Called the "anon key" in older Supabase projects; either variable name works
# (NEXT_PUBLIC_SUPABASE_ANON_KEY is read too).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Show "Continue with Google" on the sign-in page. Only set to 1 once the Google
# provider is switched on in Supabase.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=

# NEXT_PUBLIC_* values are baked in at build time. On Vercel, add the same
# variables under Project → Settings → Environment Variables and redeploy.
